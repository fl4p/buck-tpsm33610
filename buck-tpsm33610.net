		(comp
			(ref "C3")
			(value "1u")
			(footprint "Capacitor_SMD:C_0603_1608Metric")
			(fields
				(field
					(name "MPN") "CL10B105KB8NQNC")
				(field
					(name "Manufacturer") "Samsung Electro-Mechanics")
				(field
					(name "Spec") "CVCC 1 uF 50 V X7R 0603 -- Table 8-3. 0603 not 0402: VCC feeds the gate drivers and a 0402 X5R would hold about half of this at bias. VCC drives NO external load (p.5). SHARED PART with C2 (Fab 2026-09-14, 'merge what you can'). 50 V where 25 V would do, because C2 sees 36 V and one line has to cover both; at this position's 3.3 V it holds 1.021 uF (Samsung measured DC-bias data, 2026-09-14), so the merge costs this position nothing and gains derating margin. Replaces TDK CGA3E1X7R1E105K080AC -- that was AEC-Q200 and this is not, which is the one thing the merge gives up. No TDK CGA equivalent exists at 1 uF / 50 V in 0603.")
				(field
					(name "DNP") "no")
				(field
					(name "Footprint") "Capacitor_SMD:C_0603_1608Metric")
				(field
					(name "Datasheet")
				)
